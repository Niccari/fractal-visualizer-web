{
  "name": "fractal-visualizer",
  "version": "0.4.3",
  "description": "This app visualize fractal shape, running on modern browsers.",
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noemit && vite build",
    "preview": "vite preview",
    "lint": "npx @biomejs/biome lint .",
    "lint:fix": "npx @biomejs/biome check --write .",
    "test": "npx vitest run"
  },
  "keywords": [
    "Fractal",
    "Visualization-of-equations"
  ],
  "author": "Niccari",
  "license": "MIT",
  "browserslist": {
    "production": [
      "> 0.5%",
      "not dead",
      "not ie 11"
    ],
    "development": [
      "> 0.5%",
      "not dead",
      "not ie 11"
    ]
  }
}
